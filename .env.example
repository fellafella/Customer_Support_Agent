# Copiez ce fichier en ".env" et renseignez vos valeurs.
# Ne commitez JAMAIS le fichier .env (il est dans .gitignore).

# Fournisseur du LLM (actuellement pris en charge : gemini)
LLM_PROVIDER=gemini

# Clé API créée dans Google AI Studio (https://aistudio.google.com/apikey)
LLM_API_KEY=your-api-key-here

# Identifiant exact du modèle tel qu'affiché dans Google AI Studio
LLM_MODEL=gemini-3.8-flash

# Délai maximum d'attente d'une réponse du LLM, en secondes
LLM_TIMEOUT_SECONDS=20
